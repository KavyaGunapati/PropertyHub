{
  "Serilog": {
  "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
  "MinimumLevel": {
    "Default": "Information"
  },
  "WriteTo": [
    {
      "Name": "Console"
    },
    {
      "Name": "File",
      "Args": {
        "path": "Logs/log-.txt",
        "rollingInterval": "Day"
      }
    }
  ]
},
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=PropertyHub;Username=postgres;Password=Abcd@1234"
  },
  "Jwt": {
    "AccessTokenSecret": "your-super-secret-key-minimum-32-characters-long-here-1234567890",
    "RefreshTokenSecret": "your-super-secret-key-minimum-32-characters-long-here-0987654321",
    "AccessTokenExpirationInMinutes": 15,
    "RefreshTokenExpirationInMinutes": 10080,
    "Issuer": "PropertyHub",
    "Audience": "PropertyHubUsers"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
